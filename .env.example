# ─────────────────────────────────────────────────────────────────────────
#  Server-side settings (never sent to the browser)
# ─────────────────────────────────────────────────────────────────────────

# Where bancho.py is listening. This is reached server-to-server, so on a
# single-host setup it stays on localhost and is never exposed publicly.
BANCHO_API_URL=http://127.0.0.1:10000

# bancho.py routes its whole API on this Host header and 404s without it.
# It must be api.<the DOMAIN in bancho.py's .env>.
BANCHO_API_HOST=api.example.com


# ─────────────────────────────────────────────────────────────────────────
#  Public settings (inlined into the browser bundle at build time)
# ─────────────────────────────────────────────────────────────────────────

# Shown in the header, page titles and copy.
NEXT_PUBLIC_SERVER_NAME=Sunrise

# The domain players point their osu! client at — bancho.py's DOMAIN.
NEXT_PUBLIC_DOMAIN=example.com

# Where this website is reachable. Used for canonical urls and for the
# preview images chat apps show when someone posts a link, which have to be
# absolute. Defaults to https://<NEXT_PUBLIC_DOMAIN>, so set it only if the
# site lives somewhere else (a subdomain, or a different port in testing).
NEXT_PUBLIC_SITE_URL=https://example.com

# Where avatars are served from. nginx serves this straight out of
# bancho.py's .data/avatars directory.
NEXT_PUBLIC_AVATAR_URL=https://a.example.com

# Beatmap (.osz) downloads. Any osu! mirror works.
NEXT_PUBLIC_BEATMAP_MIRROR_URL=https://catboy.best/d

# Optional. Shown in the footer and referenced in the help pages.
NEXT_PUBLIC_DISCORD_INVITE=

# Registration captcha. Leave both empty to disable, and make sure this
# matches bancho.py's CAPTCHA_PROVIDER / CAPTCHA_SECRET — the server
# verifies the token, this only renders the widget.
# One of: recaptcha, hcaptcha, turnstile
NEXT_PUBLIC_CAPTCHA_PROVIDER=
NEXT_PUBLIC_CAPTCHA_SITEKEY=
